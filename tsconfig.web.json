{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@hsos/contracts/*": ["./spec/contracts/*"],
      "@hsos/ui-kit": ["./src/modules/ui-kit/index.ts"]
    }
  },
  "include": [
    "spec/contracts/**/*.ts",
    "src/ui/**/*.ts",
    "src/ui/**/*.tsx",
    "src/modules/*/panel/**/*.ts",
    "src/modules/*/panel/**/*.tsx",
    "src/modules/*/register.ui.ts",
    "src/modules/ui-kit/**/*.ts",
    "src/modules/ui-kit/**/*.tsx",
    "tests/**/*.ui.test.tsx"
  ]
}
